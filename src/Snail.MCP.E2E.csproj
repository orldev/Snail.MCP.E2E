<Project Sdk="Microsoft.NET.Sdk.Web">

  <Sdk Name="Snail.Sdk.Mcp" />

  <!--
    Native and HTTP only (Snail.Sdk.Mcp): the server runs in its own container on the stand, beside the Nomad agent it
    raises task environments through, and answers the workers of the platform at its port. Native AOT starts it in a
    third of the time and less than half the memory: about 40 ms and 39 MB against 128 ms and 97 MB framework-dependent
    (to its first health answer, median of five, macOS arm64, 2026-10-30).
  -->
  <PropertyGroup>
    <SnailMcpTransport>Http</SnailMcpTransport>
    <SnailMcpContainer>true</SnailMcpContainer>
    <SnailStatusToolsBecause>e2e_status: says where the environment stands, the app and its services, not where a job does</SnailStatusToolsBecause>
    <Version>0.1.0</Version>
    <Description>Task environments for .NET apps: run the app with its services, call its API, read logs, run tests</Description>
    <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;e2e;nomad</PackageTags>
    <RepositoryUrl>https://github.com/orldev/Snail.MCP.E2E</RepositoryUrl>
    <PackageProjectUrl>https://github.com/orldev/Snail.MCP.E2E</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Snail.Toolkit.Nomad" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.MCP.E2E.Tests" />
    <InternalsVisibleTo Include="Snail.MCP.E2E.Benchmarks" />
  </ItemGroup>

</Project>
