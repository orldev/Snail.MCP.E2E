<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central package management with more than one feed configured requires an explicit mapping (NU1507); without it a
    public package can shadow a private one of the same name. The Nomad client is not published yet and travels inside
    the repository, in packages/, the way Snail.Swarm.Agent carries it, so a container build restores it without the
    author's machine.
  -->
  <packageSources>
    <add key="Vendored" value="packages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Vendored">
      <package pattern="Snail.Toolkit.Nomad" />
    </packageSource>
  </packageSourceMapping>

</configuration>
