<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The one Snail.MCP.E2E server of this Mac, over HTTP on port 8828, started at login and again whenever it
    ends. Publishing with -p:SnailMcpInstall=true writes this job with the machine's paths beside the publications in
    ~/.s3l-mcp/Snail.MCP.E2E/ and restarts it when launchd holds this very job; otherwise it prints the commands
    that load it, which are the owner's to run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>s3l.mcp.e2e</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{CURRENT}}/Snail.MCP.E2E</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{HOME}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SNAIL_MCP_E2E_TRANSPORT</key>
        <string>http</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/Snail.MCP.E2E.log</string>
</dict>
</plist>
